{
  "name": "jeongsan-note",
  "version": "0.1.0",
  "private": true,
  "description": "정산노트 — 급여 계산기 모음 (정적 사이트)",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node scripts/serve.js",
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "node tests/e2e/run.cjs",
    "build": "node scripts/build.js",
    "build:production": "node scripts/build.js --production",
    "preview": "node scripts/serve.js --dir dist",
    "verify:production": "node scripts/build.js --production && E2E_DIR=dist E2E_PRODUCTION=1 node tests/e2e/run.cjs"
  }
}
